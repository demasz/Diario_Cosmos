{
  "name": "diario-cosmos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-html-parser": "^9.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.8"
  }
}
